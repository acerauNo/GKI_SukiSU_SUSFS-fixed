+# SPDX-License-Identifier: GPL-2.0
+config FRIDA_KMOD
+	tristate "Frida kernel-assisted injection channel"
+	default n
+	help
+	  prctl-based control channel that frida-server (kernel-assisted
+	  injector) and frida-agent (GumCloak kernel backend) drive to
+	  allocate memory, spawn threads and cloak memory ranges, threads
+	  and file descriptors inside a target process — without ptrace.
+
+	  Say Y to build it into the kernel image (recommended: no
+	  vermagic/KMI concerns, no module signature wall, invisible
+	  from /proc/modules by definition).
+
+	  If unsure, say N.
